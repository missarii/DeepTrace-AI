# ── Environment ──────────────────────────────────────────────
NODE_ENV=development

# ── Postgres / Redis ─────────────────────────────────────────
DATABASE_URL=postgresql://deeptrace:deeptrace@localhost:5432/deeptrace?schema=public
REDIS_URL=redis://localhost:6379

# ── API (NestJS) ─────────────────────────────────────────────
API_PORT=3000
JWT_ACCESS_SECRET=change-me-access-32-chars-min
JWT_REFRESH_SECRET=change-me-refresh-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:5173
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_TOKEN=change-me-internal-token

# ── Agent (Python) ───────────────────────────────────────────
AGENT_PORT=8000
AGENT_INTERNAL_TOKEN=change-me-internal-token
CHAT_PROVIDER=mock
# CHAT_PROVIDER=openai | anthropic | ollama | mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai | local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

SEARCH_PROVIDER=mock
# SEARCH_PROVIDER=tavily | brave | mock
TAVILY_API_KEY=
BRAVE_API_KEY=

# ── Budgets / limits (server-side, enforced) ─────────────────
MAX_ITERATIONS=3
MAX_SEARCH_CALLS=24
MAX_CONCURRENT_FETCH=6
MAX_CONTENT_CHARS=600000
MAX_MODEL_TOKENS=60000
MAX_RUN_SECONDS=600
MAX_EST_COST_USD=1.50
ALLOW_JS_RENDER=false
ALLOW_UPLOADS=true
MAX_UPLOAD_MB=20

# ── Frontend ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1
VITE_AGENT_URL=http://localhost:8000
